# Rust / SpacetimeDB module build output.
# `target/` is hundreds of MB. Never commit it.
target/
**/*.rs.bk
*.pdb

# Node / client
node_modules/
dist/
dist-ssr/
.vite/
*.local

# Env / secrets
.env
.env.*
!.env.example

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Logs
*.log
npm-debug.log*
yarn-error.log*

# NOTE: client/src/module_bindings/ is generated but IS committed on purpose,
# so Vanessa gets typed bindings without having to build the Rust module.
